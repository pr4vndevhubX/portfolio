---
// Vertical dot-and-line timeline, reused for the blog listing, Publications,
// and Certifications. `dateLabel` is a pre-formatted string (not a `Date`) so
// callers can choose precision — an exact day for blog posts, just a year for
// a publication or certification where no exact date is known.
interface TimelineItem {
  dateLabel: string;
  title: string;
  description: string;
  href?: string;
  tags?: string[];
  badge?: string;
  bullets?: string[];
}

interface Props {
  items: TimelineItem[];
}

const { items } = Astro.props;
---

<ol class="timeline">
  {
    items.map((item) => (
      <li class="timeline-row">
        <span class="timeline-date">{item.dateLabel}</span>
        <div class:list={['timeline-content', { 'is-latest': item.badge }]}>
          {item.badge && <p class="timeline-badge">{item.badge}</p>}
          <h3 class="timeline-title">
            {item.href ? <a href={item.href}>{item.title}</a> : item.title}
          </h3>
          <p class="timeline-desc">{item.description}</p>
          {item.bullets && item.bullets.length > 0 && (
            <ul class="timeline-bullets">
              {item.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          )}
          {item.tags && item.tags.length > 0 && (
            <p class="timeline-tags">{item.tags.map((tag) => `#${tag}`).join(' · ')}</p>
          )}
        </div>
      </li>
    ))
  }
</ol>
