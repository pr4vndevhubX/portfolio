---
import { getCollection } from 'astro:content';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pagination from '../../components/Pagination.astro';
import Timeline from '../../components/Timeline.astro';
import { withBase } from '../../lib/url';
import { SITE } from '../../consts';
import { formatDate, locale, t } from '../../i18n';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
  );
  const allTags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) =>
    a.localeCompare(b),
  );
  return paginate(posts, { pageSize: 10, props: { allTags } });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page, allTags } = Astro.props;
const posts = page.data;

const pageTitle =
  page.currentPage === 1 ? t('blog.title') : t('blog.titlePaged', { page: page.currentPage });

const monthYear = (date: Date) =>
  new Intl.DateTimeFormat(locale, { month: 'long', year: 'numeric' }).format(date);

const timelineItems = posts.map((post, index) => ({
  dateLabel: formatDate(post.data.publishDate, 'short'),
  title: post.data.title,
  description: post.data.description,
  href: withBase(`/blog/${post.id}/`),
  tags: post.data.tags,
  badge:
    page.currentPage === 1 && index === 0
      ? `Latest · ${monthYear(post.data.publishDate)}`
      : undefined,
}));
---

<BaseLayout
  title={pageTitle}
  description={`Notes and writing — ${SITE.title}, a minimal portfolio and blog theme for Astro.`}
>
  <section class="page-head section">
    <p class="eyebrow">{t('blog.eyebrow')}</p>
    <h1>Notes, essays, and release logs.</h1>
    <p class="lead">
      {
        posts.length > 0
          ? 'Writing on agentic AI, LLM engineering, and applied ML.'
          : 'Not Yet — check back soon.'
      }
    </p>
  </section>

  {
    posts.length > 0 && (
      <section class="section content-index" aria-label={t('blog.listLabel')}>
        <div class="index-sidebar">
          <p class="eyebrow">{t('blog.tagsEyebrow')}</p>
          <ul class="tag-cloud">
            {allTags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        </div>

        <div>
          <Timeline items={timelineItems} />
          <Pagination page={page} />
        </div>
      </section>
    )
  }
</BaseLayout>
