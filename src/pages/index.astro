---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import Timeline from '../components/Timeline.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';
import { SITE } from '../consts';
import { formatDate, locale, t } from '../i18n';

const projects = (await getCollection('projects'))
  .sort((a, b) => {
    const byDate = b.data.publishDate.getTime() - a.data.publishDate.getTime();
    return byDate || (a.data.order ?? 999) - (b.data.order ?? 999);
  })
  .slice(0, 3);

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 5);

const monthYear = (date: Date) =>
  new Intl.DateTimeFormat(locale, { month: 'long', year: 'numeric' }).format(date);

const timelineItems = posts.map((post, index) => ({
  dateLabel: formatDate(post.data.publishDate, 'short'),
  title: post.data.title,
  description: post.data.description,
  href: withBase(`/blog/${post.id}/`),
  tags: post.data.tags,
  badge: index === 0 ? `Latest · ${monthYear(post.data.publishDate)}` : undefined,
}));

const site = Astro.site ?? new URL(Astro.url.origin);
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  description: SITE.description,
  url: new URL(withBase('/'), site).href,
};
---

<BaseLayout description={SITE.description}>
  <StructuredData slot="head" schema={websiteSchema} />
  <section class="hero section">
    <p class="eyebrow">AI/ML Engineer / LLM &amp; Agentic AI</p>
    <h1>Building agentic AI systems that ship to production.</h1>
    <p class="lead">
      I design LLM-powered automation — multi-agent workflows, RAG pipelines, and ML-driven decision
      systems — currently building AI-driven SOC automation at Krya Solutions.
    </p>
    <div class="action-row" aria-label={t('home.primaryLinks')}>
      <a class="button" href={withBase('/projects/')}>{t('home.viewProjects')}</a>
      <a class="text-link" href={withBase('/contact/')}>Get in touch →</a>
    </div>
  </section>

  <section class="section split-overview" aria-label={t('home.overviewLabel')}>
    <div>
      <p class="eyebrow">Focus areas</p>
      <h2>LLMs, agents, and applied ML.</h2>
    </div>
    <div class="feature-list">
      <article>
        <h3>Agentic AI</h3>
        <p>
          Multi-agent workflows with LangGraph and CrewAI, from ReAct agents to scheduled pipelines.
        </p>
      </article>
      <article>
        <h3>RAG &amp; retrieval</h3>
        <p>Vector-search pipelines grounded in real data — pgvector, FAISS, semantic matching.</p>
      </article>
      <article>
        <h3>Applied ML</h3>
        <p>Deep learning and anomaly detection, from CNN ensembles to Isolation Forest models.</p>
      </article>
    </div>
  </section>

  <section class="section index-feed" aria-labelledby="latest-works">
    <div class="section-heading">
      <p class="eyebrow">{t('home.latestProjectsEyebrow')}</p>
      <h2 id="latest-works">Built records.</h2>
      <a class="text-link" href={withBase('/projects/')}>{t('home.allProjects')}</a>
    </div>

    {
      projects.length > 0 ? (
        <div class="highlight-grid">
          {projects.map((project) => (
            <article class="highlight-card">
              {project.data.thumbnail && (
                <Image
                  src={project.data.thumbnail}
                  alt=""
                  width={720}
                  height={480}
                  loading="lazy"
                />
              )}
              <div>
                <p class="meta">{formatDate(project.data.publishDate, 'short')}</p>
                <h3>
                  <a href={withBase(`/projects/${project.id}/`)}>{project.data.title}</a>
                </h3>
                <p>{project.data.description}</p>
                {project.data.tech.length > 0 && (
                  <ul
                    class="tag-list"
                    aria-label={t('home.projectTech', { title: project.data.title })}
                  >
                    {project.data.tech.slice(0, 4).map((tech) => (
                      <li>{tech}</li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state compact">
          <p set:html={t('home.projectsEmpty')} />
        </div>
      )
    }
  </section>

  <section class="section index-feed" aria-labelledby="latest-notes">
    <div class="section-heading">
      <p class="eyebrow">{t('home.latestBlogEyebrow')}</p>
      <h2 id="latest-notes">Field notes.</h2>
      <a class="text-link" href={withBase('/blog/')}>{t('home.allPosts')}</a>
    </div>

    {
      posts.length > 0 ? (
        <Timeline items={timelineItems} />
      ) : (
        <div class="empty-state compact">
          <p set:html={t('home.postsEmpty')} />
        </div>
      )
    }
  </section>
</BaseLayout>
